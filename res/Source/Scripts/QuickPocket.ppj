<?xml version='1.0'?>
<!-- Game is either sse, tesv, or fo4 -->
<PapyrusProject xmlns="PapyrusProject.xsd"
    Flags="TESV_Papyrus_Flags.flg"
    Game="sse"
    Output="../../../build/install/Scripts"
    Optimize="true"
    Anonymize="true"
    Zip="true">
    <Variables>
        <Variable Name="ModName" Value="QuickPocket - Swiftness of Stealing"/>
        <Variable Name="ThisProject" Value="."/>
        <Variable Name="Rel" Value="../../../.release"/>
        <Variable Name="Install" Value="../../../build/install"/>
        <Variable Name="MO2" Value="/mnt/Games/SDE/mods/"/>
        <Variable Name="Ver" Value="v1.0.0"/>
    </Variables>
    <Imports>
        <Import>@ThisProject</Import>       
        <Import>@MO2/Skyrim Script Extender (SKSE64) - 1.7.104/Source/Scripts</Import>
        <Import>@MO2/PapyrusUtil AE SE - Scripting Utility Functions - 1.7.104/Source/Scripts</Import>
        <Import>@MO2/SkyUI SE/Source/Scripts</Import>
        <Import>@MO2/../Game Root/Data/Source/Scripts</Import>
    </Imports>
    <Folders>
        <Folder>@ThisProject</Folder>
    </Folders>
    <ZipFiles Output="@Rel">
        <ZipFile Name="@ModName - @Ver" RootDir="@Install" Compression="deflate">
            <Match>*.esp</Match>
            <Match>*.esm</Match>
            <Include>Scripts</Include>
            <Include Path="Source/Scripts">*.psc</Include>
            <Include>SKSE</Include>
            <Include>Interface</Include>
        </ZipFile>
    </ZipFiles>
</PapyrusProject>
